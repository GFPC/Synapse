# Multi-stage build for Go API
FROM golang:1.23-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git

COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

COPY apps/api/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/synapse-api ./cmd/api

# Final minimal runtime image
FROM alpine:3.20

WORKDIR /app
RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/synapse-api /app/synapse-api
COPY apps/api/db /app/db

EXPOSE 3000
ENTRYPOINT ["/app/synapse-api"]
