# ── Environment ───────────────────────────────────────────
ENV=development
PORT=3000

# ── Database (PostgreSQL 16) ───────────────────────────────
DATABASE_URL=postgres://synapse:synapse_pass@127.0.0.1:5432/synapse?sslmode=disable
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse_pass
POSTGRES_DB=synapse

# ── Auth & JWT ─────────────────────────────────────────────
JWT_SECRET=synapse_dev_super_secret_jwt_key_32bytes_min!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── File Uploads ───────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# ── WebSocket & Soft Locks ─────────────────────────────────
WS_MAX_MESSAGE_SIZE=65536
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=50
